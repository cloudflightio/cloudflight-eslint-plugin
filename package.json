{
    "name": "@cloudflight/eslint-plugin",
    "version": "1.3.3",
    "private": true,
    "type": "module",
    "volta": {
        "node": "24.20.0",
        "yarn": "4.18.0"
    },
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "packages/*"
    ],
    "homepage": "https://github.com/cloudflightio/cloudflight-eslint-plugin",
    "bugs": {
        "url": "https://github.com/cloudflightio/cloudflight-eslint-plugin/issues"
    },
    "description": "",
    "scripts": {
        "build": "yarn workspaces foreach -pA --topological-dev run build-package",
        "lint": "eslint . && eslint -c eslint.format.mjs .",
        "test": "yarn workspaces foreach -pA run test-package",
        "postinstall": "husky",
        "publish-workspaces": "node ./scripts/prepare.mjs && yarn workspaces foreach -At --no-private npm publish"
    },
    "keywords": [
        "eslint",
        "eslintplugin"
    ],
    "author": "Cloudflight GmbH",
    "license": "Apache-2.0",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/estree": "1.0.9",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.3",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "@typescript-eslint/parser": "8.70.1",
        "@typescript-eslint/rule-tester": "8.70.1",
        "@typescript-eslint/utils": "8.70.1",
        "@vue/eslint-config-typescript": "14.9.0",
        "angular-eslint": "22.5.0",
        "eslint": "10.9.1",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-no-unsanitized": "4.1.5",
        "eslint-plugin-perfectionist": "5.11.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-security": "4.0.1",
        "eslint-plugin-vue": "10.11.0",
        "husky": "9.1.7",
        "jest": "30.5.1",
        "lint-staged": "16.2.6",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "vue-eslint-parser": "10.4.1"
    },
    "lint-staged": {
        "*.js": "eslint -c eslint.format.mjs --fix",
        "*.ts": "eslint -c eslint.format.mjs --fix"
    }
}
