{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "types": []
    },
    "include": ["**/*.ts", "**/*.vue"],
    // the explicit-tsconfig project is only reachable through tsConfigFiles
    "exclude": ["explicit-tsconfig"]
}
