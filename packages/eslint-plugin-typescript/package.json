{
    "name": "@cloudflight/eslint-plugin-typescript",
    "version": "1.3.3",
    "description": "Cloudflight eslint-plugin & eslint-config for typescript",
    "volta": {
        "extends": "../../package.json"
    },
    "keywords": [
        "eslint",
        "eslintplugin"
    ],
    "homepage": "https://github.com/cloudflightio/cloudflight-eslint-plugin",
    "bugs": {
        "url": "https://github.com/cloudflightio/cloudflight-eslint-plugin/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cloudflightio/cloudflight-eslint-plugin.git",
        "directory": "packages/eslint-plugin-typescript"
    },
    "author": "Cloudflight GmbH",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build-package": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
        "test-package": "NODE_OPTIONS=--experimental-vm-modules yarn run -T jest"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@typescript-eslint/utils": "~8.70.1",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-no-unsanitized": "~4.1.5",
        "eslint-plugin-perfectionist": "5.11.0",
        "eslint-plugin-security": "~4.0.1",
        "globals": "17.12.0",
        "tslib": "^2.8.1",
        "typescript-eslint": "~8.70.1"
    },
    "peerDependencies": {
        "eslint": "^10.4.0",
        "typescript": ">=5.0.0 <6.1.0"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "devDependencies": {
        "@types/eslint-plugin-no-unsanitized": "workspace:*",
        "@types/eslint-plugin-security": "workspace:*",
        "eslint": "10.9.1",
        "typescript": "5.9.3"
    }
}
