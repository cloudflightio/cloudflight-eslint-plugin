{
    "name": "@cloudflight/eslint-plugin-angular",
    "version": "1.3.3",
    "description": "Cloudflight eslint-plugin & eslint-config for angular",
    "volta": {
        "extends": "../../package.json"
    },
    "keywords": [
        "eslint",
        "eslintplugin"
    ],
    "homepage": "https://github.com/cloudflightio/cloudflight-eslint-plugin",
    "bugs": {
        "url": "https://github.com/cloudflightio/cloudflight-eslint-plugin/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cloudflightio/cloudflight-eslint-plugin.git",
        "directory": "packages/eslint-plugin-angular"
    },
    "author": "Cloudflight GmbH",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build-package": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
        "test-package": "NODE_OPTIONS=--experimental-vm-modules yarn run -T jest"
    },
    "dependencies": {
        "@cloudflight/eslint-plugin-typescript": "workspace:*",
        "@typescript-eslint/utils": "~8.70.1",
        "angular-eslint": "~22.5.0",
        "tslib": "^2.8.1",
        "typescript-eslint": "~8.70.1"
    },
    "peerDependencies": {
        "@angular/core": "^22.0.0",
        "eslint": "^10.4.0",
        "typescript": ">=5.0.0 <6.1.0"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "devDependencies": {
        "eslint": "10.9.1",
        "typescript": "5.9.3"
    }
}
